# =========================
# SERVER
# =========================
PORT=4000
NODE_ENV=development

# =========================
# DATABASE MYSQL
# =========================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=coiffeur_db
DB_PORT=3306

# =========================
# JWT
# =========================
JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=7d

# =========================
# FRONTEND URL
# =========================
FRONTEND_URL=http://localhost:3000

# =========================
# BACKEND URL
# =========================
BACKEND_URL=http://localhost:4000

# =========================
# UPLOADS
# =========================
UPLOADS_DIR=uploads

# =========================
# EMAIL SMTP
# =========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="PRESTIGE Salon <your_email@gmail.com>"

# =========================
# TELEGRAM OPTIONNEL
# =========================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BARBER_CHAT_ID=your_telegram_chat_id